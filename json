							"script": {
								"exec": [
									"// Sample CommerceTools Cart Object with mixed delivery methods",
									"const commerceToolsCart = {",
									"  \"id\": \"cart-mixed-delivery-456\",",
									"  \"version\": 1,",
									"  \"customerId\": \"customer-67890\",",
									"  \"customerEmail\": \"jane.doe@example.com\",",
									"  \"currency\": \"USD\",",
									"  \"lineItems\": [",
									"    {",
									"      \"id\": \"line-item-ship-1\",",
									"      \"productId\": \"product-laptop-123\",",
									"      \"variant\": {",
									"        \"sku\": \"LAPTOP-001-BLK\",",
									"        \"attributes\": [",
									"          { \"name\": \"productClass\", \"value\": \"ELECTRONICS\" },",
									"          { \"name\": \"unitOfMeasure\", \"value\": \"EA\" }",
									"        ]",
									"      },",
									"      \"price\": {",
									"        \"value\": {",
									"          \"currencyCode\": \"USD\",",
									"          \"centAmount\": 119999,",
									"          \"fractionDigits\": 2",
									"        }",
									"      },",
									"      \"quantity\": 1,",
									"      \"totalPrice\": {",
									"        \"currencyCode\": \"USD\",",
									"        \"centAmount\": 119999,",
									"        \"fractionDigits\": 2",
									"      },",
									"      \"shippingDetails\": {",
									"        \"targets\": [{",
									"          \"addressKey\": \"home-address\",",
									"          \"quantity\": 1,",
									"          \"shippingMethodKey\": \"online-ship\"",
									"        }],",
									"        \"valid\": true",
									"      }",
									"    },",
									"    {",
									"      \"id\": \"line-item-pickup-1\",",
									"      \"productId\": \"product-mouse-456\",",
									"      \"variant\": {",
									"        \"sku\": \"MOUSE-002-WHT\",",
									"        \"attributes\": [",
									"          { \"name\": \"productClass\", \"value\": \"ELECTRONICS\" },",
									"          { \"name\": \"unitOfMeasure\", \"value\": \"EA\" }",
									"        ]",
									"      },",
									"      \"price\": {",
									"        \"value\": {",
									"          \"currencyCode\": \"USD\",",
									"          \"centAmount\": 4000,",
									"          \"fractionDigits\": 2",
									"        }",
									"      },",
									"      \"quantity\": 1,",
									"      \"totalPrice\": {",
									"        \"currencyCode\": \"USD\",",
									"        \"centAmount\": 4000,",
									"        \"fractionDigits\": 2",
									"      },",
									"      \"shippingDetails\": {",
									"        \"targets\": [{",
									"          \"addressKey\": \"store-location\",",
									"          \"quantity\": 1,",
									"          \"shippingMethodKey\": \"store-pickup\"",
									"        }],",
									"        \"valid\": true",
									"      }",
									"    }",
									"  ],",
									"  \"shippingAddress\": {",
									"    \"streetName\": \"789 Customer Ave\",",
									"    \"city\": \"Austin\",",
									"    \"state\": \"TX\",",
									"    \"postalCode\": \"78701\",",
									"    \"country\": \"US\"",
									"  }",
									"};",
									"",
									"// Configuration for Vertex transformation with delivery method filtering",
									"const vertexConfig = {",
									"  \"companyCode\": pm.collectionVariables.get(\"company_code\"),",
									"  \"companyAddress\": {",
									"    \"streetAddress1\": \"456 Business Plaza\",",
									"    \"city\": \"San Francisco\",",
									"    \"mainDivision\": \"CA\",",
									"    \"postalCode\": \"94105\",",
									"    \"country\": \"US\"",
									"  },",
									"  \"defaultLocationCode\": \"SF_WAREHOUSE\",",
									"  \"defaultTaxIncludedIndicator\": false,",
									"  \"defaultDeliveryTerm\": \"FOB_DESTINATION\",",
									"  \"deliveryMethodConfig\": {",
									"    \"taxableDeliveryMethods\": [\"online-ship\", \"home-delivery\", \"standard-shipping\", \"express-shipping\"],",
									"    \"exemptDeliveryMethods\": [\"store-pickup\", \"curbside-pickup\", \"in-store-pickup\"],",
									"    \"defaultToTaxable\": true",
									"  }",
									"};",
									"",
									"// Transform CommerceTools cart to Vertex quotation request",
									"function transformToVertexQuotation(cart, config) {",
									"  const now = new Date();",
									"  const documentDate = now.toISOString().split('T')[0];",
									"  const transactionId = `CT-${cart.id}-${now.getTime()}`;",
									"  ",
									"  // Helper function to calculate actual prices with discounts",
									"  function calculateActualPrices(item) {",
									"    const unitPrice = item.price.value.centAmount / Math.pow(10, item.price.value.fractionDigits);",
									"    ",
									"    // If no discounted prices, use original total",
									"    if (!item.discountedPricePerQuantity || item.discountedPricePerQuantity.length === 0) {",
									"      return {",
									"        extendedPrice: item.totalPrice.centAmount / Math.pow(10, item.totalPrice.fractionDigits),",
									"        unitPrice: unitPrice,",
									"        discountAmount: 0",
									"      };",
									"    }",
									"    ",
									"    // Calculate discounted extended price",
									"    let totalDiscountedAmount = 0;",
									"    let totalDiscountAmount = 0;",
									"    ",
									"    item.discountedPricePerQuantity.forEach(discountInfo => {",
									"      const discountedPrice = discountInfo.discountedPrice.value.centAmount / ",
									"        Math.pow(10, discountInfo.discountedPrice.value.fractionDigits);",
									"      totalDiscountedAmount += discountedPrice * discountInfo.quantity;",
									"      ",
									"      // Calculate total discount amount",
									"      discountInfo.discountedPrice.includedDiscounts.forEach(discount => {",
									"        totalDiscountAmount += discount.discountedAmount.centAmount / ",
									"          Math.pow(10, discount.discountedAmount.fractionDigits);",
									"      });",
									"    });",
									"    ",
									"    return {",
									"      extendedPrice: totalDiscountedAmount,",
									"      unitPrice: unitPrice,",
									"      discountAmount: totalDiscountAmount",
									"    };",
									"  }",
									"  ",
									"  // Filter line items based on delivery method",
									"  function filterTaxableLineItems(lineItems, config) {",
									"    if (!config.deliveryMethodConfig) {",
									"      return lineItems;",
									"    }",
									"    ",
									"    const deliveryConfig = config.deliveryMethodConfig;",
									"    ",
									"    return lineItems.filter(item => {",
									"      // Get delivery method from shipping details",
									"      let deliveryMethod = null;",
									"      if (item.shippingDetails && item.shippingDetails.targets && item.shippingDetails.targets.length > 0) {",
									"        deliveryMethod = item.shippingDetails.targets[0].shippingMethodKey;",
									"      }",
									"      ",
									"      if (!deliveryMethod) {",
									"        // Check custom fields for delivery method",
									"        if (item.custom && item.custom.fields && item.custom.fields.deliveryMethod) {",
									"          deliveryMethod = item.custom.fields.deliveryMethod;",
									"        }",
									"      }",
									"      ",
									"      if (!deliveryMethod) {",
									"        return deliveryConfig.defaultToTaxable !== false;",
									"      }",
									"      ",
									"      // Check if taxable",
									"      if (deliveryConfig.taxableDeliveryMethods.indexOf(deliveryMethod) !== -1) {",
									"        return true;",
									"      }",
									"      ",
									"      // Check if exempt",
									"      if (deliveryConfig.exemptDeliveryMethods.indexOf(deliveryMethod) !== -1) {",
									"        return false;",
									"      }",
									"      ",
									"      return deliveryConfig.defaultToTaxable !== false;",
									"    });",
									"  }",
									"  ",
									"  // Filter taxable items",
									"  const taxableLineItems = filterTaxableLineItems(cart.lineItems, config);",
									"  ",
									"  console.log(`Total line items: ${cart.lineItems.length}`);",
									"  console.log(`Taxable line items: ${taxableLineItems.length}`);",
									"  console.log(`Items excluded from tax calculation: ${cart.lineItems.length - taxableLineItems.length}`);",
									"  ",
									"  return {",
									"    \"saleMessageType\": \"QUOTATION\",",
									"    \"transactionId\": transactionId,",
									"    \"transactionType\": \"SALE\",",
									"    \"documentNumber\": cart.id,",
									"    \"documentDate\": documentDate,",
									"    \"locationCode\": config.defaultLocationCode,",
									"    \"seller\": {",
									"      \"companyCode\": config.companyCode,",
									"      \"physicalOrigin\": config.companyAddress,",
									"      \"administrativeOrigin\": config.companyAddress",
									"    },",
									"    \"customer\": {",
									"      \"customerCode\": cart.customerId || cart.customerEmail || `GUEST-${cart.id}`,",
									"      \"destination\": {",
									"        \"streetAddress1\": cart.shippingAddress.streetName,",
									"        \"city\": cart.shippingAddress.city,",
									"        \"mainDivision\": cart.shippingAddress.state,",
									"        \"postalCode\": cart.shippingAddress.postalCode,",
									"        \"country\": cart.shippingAddress.country",
									"      }",
									"    },",
									"    \"lineItems\": taxableLineItems.map((item, index) => {",
									"      \"lineItemNumber\": index + 1,",
									"      \"product\": {",
									"        \"productClass\": item.variant.attributes?.find(attr => attr.name === 'productClass')?.value,",
									"        \"value\": item.variant.sku || item.productId",
									"      },",
									"      \"quantity\": {",
									"        \"unitOfMeasure\": item.variant.attributes?.find(attr => attr.name === 'unitOfMeasure')?.value || 'EA',",
									"        \"value\": item.quantity",
									"      },",
									"      \"unitPrice\": {",
									"        \"value\": item.price.value.centAmount / Math.pow(10, item.price.value.fractionDigits)",
									"      },",
									"      \"extendedPrice\": {",
									"        \"value\": item.totalPrice.centAmount / Math.pow(10, item.totalPrice.fractionDigits)",
									"      },",
									"      \"taxIncludedIndicator\": config.defaultTaxIncludedIndicator,",
									"      \"deliveryTerm\": config.defaultDeliveryTerm",
									"    })),",
									"    \"deliveryTerm\": config.defaultDeliveryTerm,",
									"    \"taxIncludedIndicator\": config.defaultTaxIncludedIndicator",
									"  };",
									"}",
									"",
									"// Transform the sample cart",
									"const vertexRequest = transformToVertexQuotation(commerceToolsCart, vertexConfig);",
									"",
