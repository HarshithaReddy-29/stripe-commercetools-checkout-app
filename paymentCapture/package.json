{
  "name": "payment-capture-job",
  "version": "1.0.0",
  "description": "Stripe Payment capture job",  
  "main": "index.js",
  "private": true,
"scripts": {
  "prebuild": "npm --prefix ../processor install && npm --prefix ../processor run build",
  "build": "rimraf ./build && tsc",
  "start": "node build/index.js",
    "lint": "eslint . --ext .ts",
    "prettier": "prettier --write '**/*.{js,ts}'",
    "test": "jest --config jest.config.cjs --passWithNoTests",
    "test:coverage": "npm run prebuild && jest --config jest.config.cjs --coverage",
    "test:watch": "jest --watch"
},
  "author": "",
  "license": "MIT",
 "dependencies": {
    "@commercetools-backend/loggers": "^26.0.0",
    "@commercetools/platform-sdk": "8.7.0",
    "@commercetools/ts-client": "^3.4.0",
    "axios": "^1.13.2",
    "body-parser": "^1.20.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2",
    "uuid": "^11.1.0",
    "validator": "^13.11.0",
    "@gmsb/processor": "file:../processor"

  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@tsconfig/recommended": "^1.0.3",
    "@types/express": "^4.17.14",
    "@types/jest": "^30.0.0",
    "@types/node": "^18.7.18",
    "@types/node-fetch": "^2.6.13",
    "@types/serve-static": "^2.2.0",
    "@types/validator": "^13.7.10",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "babel-jest": "^30.2.0",
    "concurrently": "^8.2.0",
    "eslint": "^9.24.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.0.1",
    "rimraf": "^6.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.1.6"
  }
}
